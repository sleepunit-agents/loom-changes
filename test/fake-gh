#!/usr/bin/env python3
"""A stand-in for gh: records every argv (and whether a token came in), answers auth token and the list query."""
import json, os, sys
log = os.environ["FAKE_GH_LOG"]
with open(log, "a") as f:
    f.write(json.dumps({"argv": sys.argv[1:], "token": os.environ.get("GH_TOKEN")}) + "\n")
a = sys.argv[1:]
if a[:2] == ["auth", "token"]:
    print(f"tok-SECRET-{a[a.index('--user') + 1]}")
    sys.exit(0)
if a[:2] == ["api", "graphql"]:
    owner = next(x.split("=", 1)[1] for x in a if x.startswith("owner="))
    if owner == "locked":
        print(f"HTTP 404: Not Found (token {os.environ.get('GH_TOKEN')})", file=sys.stderr)
        sys.exit(1)
    sys.stdout.write(open(os.environ["FAKE_GH_FIXTURE"]).read())
    sys.exit(0)
sys.exit(9)
