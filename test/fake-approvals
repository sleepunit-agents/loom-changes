#!/usr/bin/env python3
"""A stand-in for the approvals piece: rule answers from FAKE_RULES, and every call recorded."""
import json, os, sys
with open(os.environ["FAKE_APPROVALS_LOG"], "a") as f:
    f.write(json.dumps({"argv": sys.argv[1:], "stdin": None if sys.stdin.isatty() else sys.stdin.read()}) + "\n")
a = sys.argv[1:]
if a[:2] == ["rule", "merge"]:
    rules = json.loads(os.environ.get("FAKE_RULES", "{}"))
    ts = [x for x in a[2:] if not x.startswith("--") and x != a[a.index("--for") + 1]]
    print(json.dumps({t: rules.get(t, {"tier": "ask"}) for t in ts}))
elif a[:1] == ["grant"]:
    print("a-0000beef: " + ("denied" if "--deny" in a else "allowed"))
elif a[:2] == ["ui", "act"]:
    print(json.dumps({"ok": True, "message": "ok"}))
else:
    sys.exit(2)
